<Window x:Class="LatchiTeleprompter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:th="clr-namespace:LatchiTeleprompter.App.Theme"
        Title="LATCHI TELEPROMPTER"
        Width="1000" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BrushBg}"
        FontFamily="{StaticResource AppFont}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="LibraryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Padding="10,7" Margin="0,2"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPanel2}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushGoldDim}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPanel2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="StoryRow">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushText}"/>
                <TextBlock Text="{Binding Meta}" FontSize="11" Margin="0,3,0,0"
                           Foreground="{StaticResource BrushMuted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- ═══ Toolbar ═══ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <!-- brand (right side in RTL) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource BrushGold}">
                        <TextBlock Text="L" FontSize="20" FontWeight="Black" Foreground="#0A0D14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LATCHI TELEPROMPTER" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource BrushGold}"/>
                        <TextBlock Text="محرر السيناريو" FontSize="10.5" Foreground="{StaticResource BrushMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- start button (left side in RTL) -->
                <Button x:Name="BtnStart" DockPanel.Dock="Left" Style="{StaticResource GoldBtn}"
                        Click="BtnStart_Click" ToolTip="ابدأ العرض — Ctrl+Enter"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{x:Static th:Icons.Play}" Fill="#0A0D14" Width="14" Height="14"
                              Stretch="Uniform"/>
                        <TextBlock Text="ابدأ العرض" FontWeight="Bold" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <!-- main actions -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Style="{StaticResource ToolBtn}" Click="BtnNew_Click" ToolTip="قصة جديدة">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static th:Icons.NewDoc}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"/>
                            <TextBlock Text="جديد" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSave" Style="{StaticResource ToolBtn}" Click="BtnSave_Click" ToolTip="حفظ في المكتبة — Ctrl+S">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static th:Icons.Save}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"/>
                            <TextBlock Text="حفظ" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLibrary" Style="{StaticResource ToolBtn}" Click="BtnLibrary_Click" ToolTip="مكتبة القصص">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static th:Icons.Library}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"/>
                            <TextBlock Text="المكتبة" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolBtn}" Click="BtnImport_Click" ToolTip="استيراد ملف نصي">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static th:Icons.Import}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"/>
                            <TextBlock Text="استيراد" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolBtn}" Click="BtnExport_Click" ToolTip="تصدير إلى ملف نصي">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static th:Icons.Export}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"/>
                            <TextBlock Text="تصدير" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolBtn}" Click="BtnSettings_Click" ToolTip="الإعدادات والاختصارات">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static th:Icons.Settings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"/>
                            <TextBlock Text="الإعدادات" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Status bar ═══ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <TextBlock x:Name="TxtAutosaveState" DockPanel.Dock="Right" Foreground="{StaticResource BrushMuted}"
                           FontSize="11.5" VerticalAlignment="Center" Text="جاهز"/>
                <TextBlock x:Name="TxtStats" Foreground="{StaticResource BrushMuted}" FontSize="11.5"
                           VerticalAlignment="Center" Text="0 كلمة · 0 حرف · ~0:00"/>
            </DockPanel>
        </Border>

        <!-- ═══ Content: editor + library flyout ═══ -->
        <Grid>
            <TextBox x:Name="Editor" Style="{StaticResource DarkTextBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontSize="15" BorderThickness="0"
                     Padding="26,18" TextChanged="Editor_TextChanged"
                     VerticalContentAlignment="Top"/>

            <!-- first-run hint (only while editor is empty) -->
            <TextBlock x:Name="TxtHint" IsHitTestVisible="False" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource BrushMuted}"
                       TextAlignment="Center" Opacity="0.85" Visibility="Collapsed">
                <Run Text="الصق السيناريو هنا، ثم اضغط «ابدأ العرض»"/><LineBreak/>
                <Run Text="يُحفظ نصّك تلقائياً — لن يضيع" FontSize="12"/>
            </TextBlock>

            <!-- ═══ Library flyout ═══ -->
            <Border x:Name="LibraryPanel" Width="330" HorizontalAlignment="Left"
                    Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,1,0" Visibility="Collapsed">
                <DockPanel Margin="10">
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Text="مكتبة القصص" Style="{StaticResource SectionTitle}"/>
                        <Button Style="{StaticResource ToolBtn}" HorizontalAlignment="Left" Padding="6,4"
                                Click="BtnLibraryClose_Click" ToolTip="إغلاق">
                            <Path Data="{x:Static th:Icons.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.8"/>
                        </Button>
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource ToolBtn}" Click="BtnStoryOpen_Click" Content="فتح" Padding="10,5"/>
                        <Button Style="{StaticResource ToolBtn}" Click="BtnStoryRename_Click" Content="إعادة تسمية" Padding="10,5"/>
                        <Button Style="{StaticResource ToolBtn}" Click="BtnStoryDuplicate_Click" Content="تكرار" Padding="10,5"/>
                        <Button Style="{StaticResource DangerBtn}" Click="BtnStoryDelete_Click" Content="حذف" Padding="10,5"/>
                    </StackPanel>
                    <ListBox x:Name="LibraryList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="LibraryList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemTemplate="{StaticResource StoryRow}"
                             ItemContainerStyle="{StaticResource LibraryItemStyle}"
                             MouseDoubleClick="LibraryList_MouseDoubleClick"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
