<Window x:Class="LatchiTeleprompter.App.Views.TeleprompterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:th="clr-namespace:LatchiTeleprompter.App.Theme"
        Title="LATCHI TELEPROMPTER — عرض"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="#06080F" ShowActivated="True"
        FontFamily="{StaticResource AppFont}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewMouseMove="Window_PreviewMouseMove"
        Closing="Window_Closing">

    <Grid x:Name="Root">

        <!-- ═══ Scrolling viewport ═══ -->
        <Border x:Name="Viewport" Background="#0A0D14" ClipToBounds="True">
            <Canvas x:Name="ScrollCanvas">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MirrorScale" ScaleX="1"/>
                        <TranslateTransform x:Name="ScrollTransform"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
                <StackPanel x:Name="ContentPanel" Canvas.Left="0" Canvas.Top="0">
                    <!-- leading spacer: lets the first line enter the focus area naturally -->
                    <Rectangle x:Name="TopSpacer" Height="10"/>
                    <TextBlock x:Name="ScriptText"
                               TextWrapping="Wrap"
                               FontSize="48" LineHeight="74"
                               Foreground="#ECEFF6"
                               TextOptions.TextRenderingMode="ClearType"/>
                    <!-- trailing spacer: the last line can still reach the focus area -->
                    <Rectangle x:Name="BottomSpacer" Height="10"/>
                </StackPanel>
            </Canvas>
        </Border>

        <!-- ═══ Focus guide (subtle band around the reading line) ═══ -->
        <Canvas x:Name="GuideCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="GuideFill" Fill="#FFFFFF" Opacity="0.05" Height="60"
                       Canvas.Left="0" Canvas.Top="0" Width="10"/>
            <Rectangle x:Name="GuideTop" Fill="#F2C14E" Opacity="0.35" Height="1"
                       Canvas.Left="0" Canvas.Top="0" Width="10"/>
            <Rectangle x:Name="GuideBottom" Fill="#F2C14E" Opacity="0.35" Height="1"
                       Canvas.Left="0" Canvas.Top="0" Width="10"/>
        </Canvas>

        <!-- ═══ Progress bar (thin, top) ═══ -->
        <Grid x:Name="ProgressWrap" Height="3" VerticalAlignment="Top">
            <Rectangle Fill="#161B29"/>
            <Rectangle x:Name="ProgressFill" Fill="#F2C14E" Height="3" Width="0"
                       HorizontalAlignment="Left"/>
        </Grid>

        <!-- ═══ Hint (short-lived) ═══ -->
        <Border x:Name="HintBar" VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="#CC10141F" CornerRadius="0,0,8,8" Padding="14,7" Margin="0,3,0,0">
            <TextBlock Foreground="#8B94A7" FontSize="12" Text="مسافة: تشغيل/إيقاف · ← →: تقديم/تأخير · ↑ ↓: السرعة · Esc: خروج"/>
        </Border>

        <!-- ═══ Countdown ═══ -->
        <Border x:Name="CountdownOverlay" Background="#E606080F" Visibility="Collapsed">
            <TextBlock x:Name="CountdownText" Text="3" FontSize="240" FontWeight="Bold"
                       Foreground="#F2C14E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- ═══ End banner ═══ -->
        <Border x:Name="EndBanner" Background="#E606080F" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="نهاية النص" FontSize="42" FontWeight="Bold" Foreground="#F2C14E"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="يمكنك إعادة التشغيل أو الرجوع للخلف أو الخروج" FontSize="15"
                           Foreground="#8B94A7" HorizontalAlignment="Center" Margin="0,10,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource GoldBtn}" Click="BtnEndRestart_Click" Content="إعادة من البداية" Margin="6"/>
                    <Button Style="{StaticResource ToolBtn}" Background="#33FFFFFF" Click="BtnEndExit_Click" Content="خروج" Margin="6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Controls (auto-hide) ═══ -->
        <Border x:Name="ControlsBar" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#D910141F" BorderBrush="#232A3D" BorderThickness="1"
                CornerRadius="12" Padding="14,10" Margin="0,0,0,14" FlowDirection="RightToLeft">
            <StackPanel>
                <!-- row 1: playback -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnPlayPause" Style="{StaticResource RoundBtn}" Click="BtnPlayPause_Click" ToolTip="تشغيل/إيقاف — مسافة">
                        <Path x:Name="IcoPlay" Data="{x:Static th:Icons.Play}" Fill="{StaticResource BrushGold}" Width="17" Height="17" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource RoundBtn}" Click="BtnRestart_Click" ToolTip="من البداية — Home">
                        <Path Data="{x:Static th:Icons.Restart}" Stroke="{StaticResource BrushText}" Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.8"/>
                    </Button>
                    <Button Style="{StaticResource RoundBtn}" Click="BtnBack_Click" ToolTip="رجوع قليلاً — ←">
                        <Path Data="{x:Static th:Icons.JumpBack}" Stroke="{StaticResource BrushText}" Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.8"/>
                    </Button>
                    <Button Style="{StaticResource RoundBtn}" Click="BtnFwd_Click" ToolTip="تقديم قليلاً — →">
                        <Path Data="{x:Static th:Icons.JumpFwd}" Stroke="{StaticResource BrushText}" Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.8"/>
                    </Button>
                    <TextBlock x:Name="TxtPercent" Text="0%" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushGold}" VerticalAlignment="Center" Margin="12,0" MinWidth="48" TextAlignment="Center"/>
                    <TextBlock x:Name="TxtRemaining" Text="~0:00" FontSize="12.5"
                               Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource RoundBtn}" Click="BtnExit_Click" ToolTip="خروج — Esc">
                        <Path Data="{x:Static th:Icons.Close}" Stroke="{StaticResource BrushText}" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.8"/>
                    </Button>
                </StackPanel>
                <!-- row 2: live settings -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="السرعة" FontSize="11.5" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="SldSpeed" Style="{StaticResource GoldSlider}" Width="150" Minimum="1" Maximum="100"
                            ValueChanged="SldSpeed_ValueChanged"/>
                    <TextBlock x:Name="TxtSpeed" Text="45" FontSize="11.5" Foreground="{StaticResource BrushText}" VerticalAlignment="Center" Margin="6,0,14,0" MinWidth="18"/>
                    <TextBlock Text="الخط" FontSize="11.5" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource RoundBtn}" Width="30" Height="30" Click="BtnFontDown_Click" ToolTip="تصغير الخط — Ctrl + -">
                        <Path Data="{x:Static th:Icons.Minus}" Stroke="{StaticResource BrushText}" Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.8"/>
                    </Button>
                    <TextBlock x:Name="TxtFont" Text="48" FontSize="11.5" Foreground="{StaticResource BrushText}" VerticalAlignment="Center" Margin="4,0" MinWidth="24" TextAlignment="Center"/>
                    <Button Style="{StaticResource RoundBtn}" Width="30" Height="30" Click="BtnFontUp_Click" ToolTip="تكبير الخط — Ctrl + +">
                        <Path Data="{x:Static th:Icons.Plus}" Stroke="{StaticResource BrushText}" Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.8"/>
                    </Button>
                    <TextBlock Text="العرض" FontSize="11.5" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                    <Slider x:Name="SldWidth" Style="{StaticResource GoldSlider}" Width="110" Minimum="30" Maximum="100"
                            ValueChanged="SldWidth_ValueChanged"/>
                    <TextBlock Text="موضع القراءة" FontSize="11.5" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <Slider x:Name="SldFocus" Style="{StaticResource GoldSlider}" Width="90" Minimum="0.20" Maximum="0.70"
                            ValueChanged="SldFocus_ValueChanged"/>
                    <Button x:Name="BtnGuide" Style="{StaticResource RoundBtn}" Width="34" Height="34" Click="BtnGuide_Click" ToolTip="الدليل البصري">
                        <Path Data="{x:Static th:Icons.Guide}" Stroke="{StaticResource BrushGold}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.6"/>
                    </Button>
                    <Button x:Name="BtnMirror" Style="{StaticResource RoundBtn}" Width="34" Height="34" Click="BtnMirror_Click" ToolTip="وضع المرآة (زجاج التيليبرومتر)">
                        <Path Data="{x:Static th:Icons.Mirror}" Stroke="{StaticResource BrushText}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.6"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
