<Window x:Class="LatchiTeleprompter.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:th="clr-namespace:LatchiTeleprompter.App.Theme"
        Title="الإعدادات"
        Width="520" SizeToContent="Height" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        Background="{StaticResource BrushBg}"
        FontFamily="{StaticResource AppFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
        <StackPanel Margin="18">

            <!-- ═══ Teleprompter defaults ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="العرض" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="حجم الخط" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <Slider x:Name="SldFont" Style="{StaticResource GoldSlider}" Width="240" Minimum="24" Maximum="120"/>
                        <TextBlock x:Name="TxtFontVal" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource BrushText}" MinWidth="30"/>
                    </StackPanel>

                    <TextBlock Text="سرعة التمرير الافتراضية" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <Slider x:Name="SldSpeed" Style="{StaticResource GoldSlider}" Width="240" Minimum="1" Maximum="100"/>
                        <TextBlock x:Name="TxtSpeedVal" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource BrushText}" MinWidth="30"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BtnVs" Style="{StaticResource ToolBtn}" Content="بطيء جداً" Padding="9,4" FontSize="11.5" Click="Preset_Click" Tag="10"/>
                        <Button x:Name="BtnS"  Style="{StaticResource ToolBtn}" Content="بطيء" Padding="9,4" FontSize="11.5" Click="Preset_Click" Tag="25"/>
                        <Button x:Name="BtnN"  Style="{StaticResource ToolBtn}" Content="عادي" Padding="9,4" FontSize="11.5" Click="Preset_Click" Tag="45"/>
                        <Button x:Name="BtnF"  Style="{StaticResource ToolBtn}" Content="سريع" Padding="9,4" FontSize="11.5" Click="Preset_Click" Tag="65"/>
                        <Button x:Name="BtnVf" Style="{StaticResource ToolBtn}" Content="سريع جداً" Padding="9,4" FontSize="11.5" Click="Preset_Click" Tag="85"/>
                    </StackPanel>

                    <TextBlock Text="عرض النص" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <Slider x:Name="SldWidth" Style="{StaticResource GoldSlider}" Width="240" Minimum="30" Maximum="100"/>
                        <TextBlock x:Name="TxtWidthVal" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource BrushText}" MinWidth="40"/>
                    </StackPanel>

                    <TextBlock Text="موضع القراءة (حسب موضع الكاميرا)" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <Slider x:Name="SldFocus" Style="{StaticResource GoldSlider}" Width="240" Minimum="0.20" Maximum="0.70"/>
                        <TextBlock x:Name="TxtFocusVal" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource BrushText}" MinWidth="40"/>
                    </StackPanel>

                    <TextBlock Text="المحاذاة" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <StackPanel x:Name="AlignRow" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="AlAuto" Style="{StaticResource ToolBtn}" Content="تلقائي" Padding="10,4" Click="Align_Click" Tag="auto"/>
                        <Button x:Name="AlRight" Style="{StaticResource ToolBtn}" Content="يمين" Padding="10,4" Click="Align_Click" Tag="right"/>
                        <Button x:Name="AlCenter" Style="{StaticResource ToolBtn}" Content="وسط" Padding="10,4" Click="Align_Click" Tag="center"/>
                        <Button x:Name="AlLeft" Style="{StaticResource ToolBtn}" Content="يسار" Padding="10,4" Click="Align_Click" Tag="left"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="ChkGuide" Style="{StaticResource Switch}" Content="الدليل البصري (منطقة التركيز)" Margin="0,4"/>
                        <CheckBox x:Name="ChkCountdown" Style="{StaticResource Switch}" Content="العد التنازلي قبل البدء" Margin="0,4"/>
                        <CheckBox x:Name="ChkProgress" Style="{StaticResource Switch}" Content="إظهار مؤشر التقدم" Margin="0,4"/>
                        <CheckBox x:Name="ChkMirror" Style="{StaticResource Switch}" Content="وضع المرآة (لزجاج التيليبرومتر)" Margin="0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Startup ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="بدء التشغيل" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="ChkReopen" Style="{StaticResource Switch}" Content="فتح آخر قصة عند التشغيل" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- ═══ Shortcuts help ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="اختصارات لوحة المفاتيح" Style="{StaticResource SectionTitle}"/>
                    <TextBlock FontSize="12" LineHeight="24" Foreground="{StaticResource BrushMuted}" xml:space="preserve"><Run Text="أثناء القراءة:  مسافة تشغيل/إيقاف · Esc خروج · ← → تقديم/تأخير · ↑ ↓ السرعة"/><LineBreak/><Run Text="                 Ctrl + +/− حجم الخط · Home البداية · عجلة الفأرة تمرير يدوي"/><LineBreak/><Run Text="في المحرر:      Ctrl+Enter بدء العرض · Ctrl+S حفظ"/></TextBlock>
                </StackPanel>
            </Border>

            <!-- ═══ Data ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="البيانات" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolBtn}" Content="فتح مجلد البيانات" Click="BtnOpenData_Click"/>
                        <Button Style="{StaticResource DangerBtn}" Content="مسح جميع البيانات…" Click="BtnClearData_Click"/>
                    </StackPanel>
                    <TextBlock Text="كل بياناتك محفوظة محلياً في جهازك فقط — بلا إنترنت وبلا حساب."
                               FontSize="11" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ actions ═══ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,6">
                <Button x:Name="BtnSave" Style="{StaticResource GoldBtn}" Content="حفظ" Width="110" Click="BtnSave_Click"/>
                <Button Style="{StaticResource ToolBtn}" Content="إلغاء" Width="90" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
